# Root .env template. scripts/deploy.sh generates the full .env from infra/main.bicep outputs;
# only copy this template when manually pointing to an existing deployment.
# Entra ID authentication (az login / azd auth login): no service keys, except the Application Insights
# connection string.
# Load into the shell: set -a && . ./.env && set +a

AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-foundry-docs-runtime
AZURE_LOCATION=swedencentral
AZURE_AI_ACCOUNT_NAME=aif-docs-<suffix>
AZURE_AI_PROJECT_NAME=proj-docs
AZURE_AI_PROJECT_ID=/subscriptions/<subscription>/resourceGroups/rg-foundry-docs-runtime/providers/Microsoft.CognitiveServices/accounts/aif-docs-<suffix>/projects/proj-docs
AZURE_AI_PROJECT_ENDPOINT=https://aif-docs-<suffix>.services.ai.azure.com/api/projects/proj-docs
FOUNDRY_PROJECT_ENDPOINT=https://aif-docs-<suffix>.services.ai.azure.com/api/projects/proj-docs
AZURE_OPENAI_ENDPOINT=https://aif-docs-<suffix>.openai.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.6-terra
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
STORAGE_ACCOUNT_NAME=stdocs<suffix>
STORAGE_ACCOUNT_URL=https://stdocs<suffix>.blob.core.windows.net
SEARCH_SERVICE_NAME=srch-docs-<suffix>
SEARCH_ENDPOINT=https://srch-docs-<suffix>.search.windows.net
SEARCH_CONNECTION_NAME=aisearch
APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=00000000-0000-0000-0000-000000000000;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/"

# Customer documents (health data) must not be sent in telemetry.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
ENABLE_SENSITIVE_DATA=false
